# Copie para .env. Nenhum valor real entra neste arquivo.

# Banco da aplicação.
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB_NAME=store

# Banco usado pela suíte de testes. Quando vazio, o pytest sobe um
# MongoDB descartável em container (testcontainers) e usa esse.
# MONGODB_URL_TEST=mongodb://localhost:27017
MONGODB_DB_NAME_TEST=test_store

# --- Portas publicadas no host ---
# Mude quando outro projeto ja estiver usando alguma delas.
API_PORT=8000
MONGO_PORT=27017
